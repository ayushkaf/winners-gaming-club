# ---------------------------------------------------------------------------
# Winners Gaming Club — example environment file.
#
# Copy this to `app/.env` and edit. NOT to the repo root: the server loads its
# environment with `import 'dotenv/config'` (app/server/index.js), and dotenv
# reads `.env` from the process working directory — every npm script in
# app/package.json runs with that directory set to `app/`.
#
#     cp .env.example app/.env
#
# `.env` and `.env.*` are gitignored (this example file is the one exception).
# Never commit a filled-in copy.
#
# IMPORTANT — the CLI scripts do not read this file. Only `npm start` /
# `npm run dev` load dotenv. `npm run seed` and `npm run test:ledger` import
# the database module directly without it, so anything they need
# (WGC_OWNER_*, WGC_DB_PATH) must be exported in the real shell environment:
#
#     WGC_OWNER_EMAIL=you@example.com WGC_OWNER_PASSWORD='...' npm run seed
#
# Every value below is a placeholder. None of them is a working credential,
# and nothing in this codebase talks to a payment processor, so there is no
# card, merchant, or PSP key to configure — there is nothing of that kind to
# put here by design.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port the Express server binds to. Read in app/server/index.js.
# Safe default if unset: 3000.
PORT=3000

# Standard Node environment flag. The only thing this codebase uses it for is
# the session cookie's `secure` attribute (app/server/auth.js): set it to
# `production` and the cookie is only ever sent over HTTPS. Leave it unset or
# set it to `development` when running on plain http://localhost, otherwise
# the browser will silently drop the session cookie and logins will not stick.
NODE_ENV=development


# ---------------------------------------------------------------------------
# Sessions — the one secret that actually matters
# ---------------------------------------------------------------------------

# HMAC key used to sign the `wgc_session` JWT (app/server/auth.js). There is
# NO secure default: if this is unset, the code falls back to a hardcoded
# dev-only placeholder string that is published in this public repository, and
# anyone who reads the source can forge a session cookie for any account —
# including the owner. Treat an unset value as "this instance has no
# authentication".
#
# Generate a real one and keep it out of version control:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every existing session (everyone is logged out),
# which is also how you revoke sessions in an emergency.
WGC_JWT_SECRET=replace-me-with-a-long-random-string


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Path to the SQLite file, read in app/server/db.js and handed straight to
# node:sqlite's DatabaseSync. Relative paths resolve against the working
# directory (`app/`), not against this file.
#
# Default if unset: app/data/winners.sqlite — which is gitignored, along with
# its -wal/-shm sidecars. Those sidecars hold committed and uncommitted rows
# and are routinely larger than the main file, so if you move the database
# somewhere else, make sure the new location is excluded from git too.
#
# The literal value `:memory:` is special-cased: schema is created fresh in
# RAM and nothing is persisted. That is what app/server/test_ledger_integrity.js
# sets for itself so the integrity test can never touch real data.
WGC_DB_PATH=data/winners.sqlite


# ---------------------------------------------------------------------------
# Outbound email (optional) — forgot-password codes only
# ---------------------------------------------------------------------------
# app/server/mailer.js sends exactly one kind of message: the six-digit
# password-reset code. SMTP is opt-in and off by default.
#
# With HOST, USER and PASS all set, the code is emailed through nodemailer.
# With any of them missing, nothing is sent: the message body is printed to
# the server's stdout instead (so the flow stays testable), and only a
# metadata line — recipient and subject, never the body — is written to the
# system log. That distinction is deliberate: the log table is persisted and
# rendered verbatim on the owner's /owner/logs page, and a reset code sitting
# there next to the account's own email address would be a durable
# account-takeover token.
#
# Leave the whole block commented out for local development.

# SMTP server hostname. No default — absent means "don't send email".
#WGC_SMTP_HOST=smtp.example.invalid

# SMTP port. Defaults to 587 if unset. Port 465 (and only 465) switches the
# transport to implicit TLS.
#WGC_SMTP_PORT=587

# SMTP username. Usually the full mailbox address.
#WGC_SMTP_USER=no-reply@example.invalid

# SMTP password or app-specific token. A real secret — same handling rules as
# WGC_JWT_SECRET: never commit it, never paste it into an issue or a log.
#WGC_SMTP_PASS=replace-me-with-an-smtp-app-password

# Address in the From: header. Falls back to WGC_SMTP_USER if unset.
#WGC_SMTP_FROM=Winners Gaming Club <no-reply@example.invalid>


# ---------------------------------------------------------------------------
# First-run seeding (app/server/seed.js — read from the shell, not from .env)
# ---------------------------------------------------------------------------
# `npm run seed` creates the single owner account that bootstraps the role
# hierarchy on an empty database. It is safe to re-run: it no-ops if an owner
# already exists, and promotes a matching account instead of duplicating it.
#
# Remember the caveat at the top of this file — seed.js does not load dotenv,
# so these must be set in the actual environment on the command line. Setting
# them here only documents the names.

# Email for the first owner account. Default if unset: owner@winners.demo
#WGC_OWNER_EMAIL=owner@example.invalid

# Password for that account. Default if unset: a hardcoded placeholder that is
# printed to the console and is public in this repository — usable for a
# throwaway local run, unacceptable for anything anyone else can reach.
# Minimum length enforced elsewhere in the app is 8 characters.
#WGC_OWNER_PASSWORD=replace-me-before-seeding

# Display name for the first owner. Default if unset: "Platform Owner".
#WGC_OWNER_NAME=Platform Owner

# HMAC pepper for pseudonymising email addresses written to system_log.
#
# system_log is rendered verbatim to owner-tier accounts at /owner/logs, so raw
# addresses are never stored there — only a 16-hex-character HMAC digest. The
# pepper must be STABLE (a change breaks correlation with existing history) and
# SECRET (without it the HMAC degrades to a plain hash, and the email space is
# small enough to confirm a guess against). Falls back to WGC_JWT_SECRET so a
# fresh clone runs unconfigured; set it explicitly in production.
WGC_LOG_PEPPER=
