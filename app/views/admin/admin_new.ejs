<%- include('../partials/head', { title, user, activeNav: 'admin' }) %>
<div class="container narrow">
  <div class="page-head"><h1>Create admin</h1><p><a href="/admin">&larr; My admins</a></p></div>
  <div class="card">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/admin/my-admins/new">
      <div class="field"><label>Display name</label><input type="text" name="displayName" required value="<%= form.displayName || '' %>"></div>
      <div class="field"><label>Email</label><input type="email" name="email" required value="<%= form.email || '' %>"></div>
      <div class="field"><label>Temporary password</label><input type="password" name="password" required minlength="8"></div>
      <p class="hint">This admin will report to you (<%= user.staff_id %>) and will only ever see the players
      assigned to them — not your other admins' players.</p>
      <div style="margin-top:16px;"><button class="btn primary" type="submit">Create admin</button></div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
