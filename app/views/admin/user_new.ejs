<%- include('../partials/head', { title, user, activeNav: 'admin' }) %>
<div class="container narrow">
  <div class="page-head"><h1>Create user</h1><p><a href="/admin/users">&larr; Users</a></p></div>
  <div class="card">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/admin/users/new">
      <div class="field"><label>Display name</label><input type="text" name="displayName" required value="<%= form.displayName || '' %>"></div>
      <div class="field"><label>Email</label><input type="email" name="email" required value="<%= form.email || '' %>"></div>
      <div class="field"><label>Temporary password</label><input type="password" name="password" required minlength="8"></div>
      <div class="field"><label>Address (optional, self-reported, not verified)</label><input type="text" name="address" value="<%= form.address || '' %>"></div>
      <span class="demo-credit-note">New accounts start at 0 Club Credits — use the adjustment tool afterward if needed.</span>
      <p class="hint">This player will be assigned to you (<%= user.staff_id %>) automatically.</p>
      <div style="margin-top:16px;"><button class="btn primary" type="submit">Create user</button></div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
