<%- include('partials/head', { title, user, activeNav: 'login' }) %>
<div class="container narrow">
  <div class="card auth-card">
    <h2 style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:.02em;color:var(--gold);font-weight:400;font-size:26px;">Forgot password</h2>
    <% if (sent) { %>
      <div class="alert success">If that email has an account, a 6-digit code is on its way. It expires in 15 minutes.</div>
      <p style="margin-top:14px;"><a class="btn primary" href="/reset-password?email=<%= encodeURIComponent(email || '') %>" style="width:100%;display:block;text-align:center;">I have my code</a></p>
    <% } else { %>
      <p style="color:var(--dim);font-size:14.5px;">Enter the email you signed up with — we'll send a one-time code to reset your password.</p>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="post" action="/forgot-password">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>
        <button class="btn primary" type="submit" style="width:100%;">Send code</button>
      </form>
    <% } %>
    <p style="margin-top:16px;color:var(--dim);font-size:14px;">Can't access that email? Ask whoever manages your
    account (your assigned admin, or the owner) to reset it for you from their staff panel instead.
    <a href="/login">Back to log in</a></p>
  </div>
</div>
<%- include('partials/foot') %>
