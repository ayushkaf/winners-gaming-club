<%- include('../partials/head', { title, user, activeNav: 'owner' }) %>
<div class="container narrow">
  <div class="page-head"><h1>Create staff account</h1><p><a href="/owner/admins">&larr; Staff accounts</a></p></div>
  <div class="card">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/owner/admins/new">
      <div class="field"><label>Display name</label><input type="text" name="displayName" required value="<%= form.displayName || '' %>"></div>
      <div class="field"><label>Email</label><input type="email" name="email" required value="<%= form.email || '' %>"></div>
      <div class="field"><label>Temporary password</label><input type="password" name="password" required minlength="8"></div>
      <div class="field">
        <label>Permission level</label>
        <select name="role">
          <option value="admin" <%= form.role==='admin' ? 'selected' : '' %>>Admin — user management, ledger, chat (own assigned players only)</option>
          <option value="developer" <%= form.role==='developer' ? 'selected' : '' %>>Developer — same as admin, plus visibility across every admin's players</option>
          <option value="owner" <%= form.role==='owner' ? 'selected' : '' %>>Owner — full system access, including this page</option>
        </select>
      </div>
      <p class="hint">A Staff ID (e.g. <code>ADMIN01</code> / <code>DEV01</code>) is generated automatically for
      admin/developer accounts. Players quote it to route their signup or support request to this person.</p>
      <button class="btn primary" type="submit">Create account</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
