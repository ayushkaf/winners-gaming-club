<%- include('partials/head', { title, user, activeNav: 'login' }) %>
<div class="container narrow">
  <div class="card auth-card">
    <h2 style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:.02em;color:var(--gold);font-weight:400;font-size:26px;">Reset password</h2>
    <p style="color:var(--dim);font-size:14.5px;">Enter the 6-digit code we emailed you, plus a new password.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/reset-password">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" value="<%= email || '' %>">
      </div>
      <div class="field">
        <label for="code">6-digit code</label>
        <input type="text" id="code" name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" style="letter-spacing:.3em;">
      </div>
      <div class="field">
        <label for="password">New password</label>
        <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
        <span class="hint">At least 8 characters.</span>
      </div>
      <button class="btn primary" type="submit" style="width:100%;">Reset password</button>
    </form>
    <p style="margin-top:16px;color:var(--dim);font-size:14px;">Didn't get a code? <a href="/forgot-password">Send another</a> · <a href="/login">Back to log in</a></p>
  </div>
</div>
<%- include('partials/foot') %>
